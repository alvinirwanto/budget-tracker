# Copy this file to .env.local for local work, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# Put the database name in it, for example .../luar?retryWrites=true&w=majority
MONGODB_URI=

# Long random text used to sign login cookies. Make one with:
#   openssl rand -base64 48
AUTH_SECRET=
